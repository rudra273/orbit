# Copy to .env and fill in. .env is git-ignored.

# Local development database from docker-compose.yml
DATABASE_URL=postgres://orbit:orbit-dev-only@127.0.0.1:54329/orbit

# The one brain this deployment holds. Generate once with: uuidgen
ORBIT_TENANT_ID=

# Bearer token for connectors (Phase 0 only; OAuth replaces it). Generate with: openssl rand -hex 32
ORBIT_TOKEN=

ORBIT_BIND=127.0.0.1:8787

# Search by meaning. Without a key, search is by words only. Create an OpenRouter key for Orbit
# alone, with a small credit limit. Text labelled `sensitive` is never sent.
OPENROUTER_API_KEY=
# The embedding space. Changing either builds a new space in the background; it takes over
# once it has caught up.
ORBIT_EMBED_MODEL=qwen/qwen3-embedding-8b
ORBIT_EMBED_DIMS=4096
# OpenRouter providers: documents use the first that is up; each query is sent to all at once
# and the first answer wins.
ORBIT_EMBED_PROVIDERS=deepinfra,nebius
