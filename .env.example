# Copy to .env and fill in. .env is git-ignored.

# Local development database from docker-compose.yml
DATABASE_URL=postgres://orbit:orbit-dev-only@127.0.0.1:54329/orbit

# The one brain this deployment holds. Generate once with: uuidgen
ORBIT_TENANT_ID=

# Bearer token for connectors (Phase 0 only; OAuth replaces it). Generate with: openssl rand -hex 32
ORBIT_TOKEN=

ORBIT_BIND=127.0.0.1:8787
